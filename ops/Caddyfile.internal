# Internal Caddyfile for the binge-web container.
# TLS is terminated by the shared edge Caddy; this just serves static files.
:80 {
	root * /srv/www
	encode zstd gzip
	file_server

	header -Server

	# Mutually exclusive cache classes (Caddy header directives don't
	# reliably override each other, so matchers must not overlap):
	# HTML always revalidates — it carries the ?v= cache-bust versions.
	@html path / /index.html
	header @html Cache-Control "no-cache"
	# The catalogue changes daily — cache briefly.
	@data path /data/*
	header @data Cache-Control "public, max-age=900"
	# Everything else (css/js) is version-busted — cache for a day.
	@assets {
		not path / /index.html /data/*
	}
	header @assets Cache-Control "public, max-age=86400"
}
