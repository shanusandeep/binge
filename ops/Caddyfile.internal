# Internal Caddyfile for the binge-web container.
# TLS is terminated by the shared edge Caddy; this just serves static files.
:80 {
	root * /srv/www
	encode zstd gzip
	# admin dashboard is its own page, not the SPA shell
	rewrite /admin /admin.html
	# SPA routes (/recent, /all-time, …) all serve the app shell
	try_files {path} /index.html
	file_server

	header -Server

	# Mutually exclusive cache classes (Caddy header directives don't
	# reliably override each other, so matchers must not overlap):
	# HTML always revalidates — it carries the ?v= cache-bust versions.
	@html {
		not path /css/* /js/* /data/* /assets/*
	}
	header @html Cache-Control "no-cache"
	# The catalogue changes daily — cache briefly.
	@data path /data/*
	header @data Cache-Control "public, max-age=900"
	# Version-busted css/js — cache for a day.
	@assets path /css/* /js/* /assets/*
	header @assets Cache-Control "public, max-age=86400"
}
